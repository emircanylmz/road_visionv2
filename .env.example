# Docker PostgreSQL
POSTGRES_DB=roadvision
POSTGRES_USER=roadvision
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5433

# RoadVision ana süreç bağlantısı
ROADVISION_DB_DSN=postgresql://roadvision:change_me_local_only@127.0.0.1:5433/roadvision

# Web paneli (WEB_PLANI.md, Faz 0–2) — salt-okunur roadvision_web rolünün
# parolası. compose api servisi DSN'i bundan kurar; host'ta uvicorn
# çalıştırırken örnek DSN aşağıdadır. API portu için ROADVISION_WEB_PORT.
ROADVISION_WEB_PASSWORD=change_me_web_only
#ROADVISION_WEB_PORT=8800
# nginx (SPA + /api proxy) portu, Faz 2:
#ROADVISION_WEB_HTTP_PORT=8080
#ROADVISION_WEB_DSN=postgresql://roadvision_web:change_me_web_only@127.0.0.1:5433/roadvision
# Faz 1 kimlik ayarları (varsayılanlar parantez içinde). cookie_secure,
# Faz 2'de nginx+TLS arkasında true yapılmalıdır.
#ROADVISION_WEB_COOKIE_SECURE=false
#ROADVISION_WEB_SESSION_TTL_HOURS=12
#ROADVISION_WEB_SESSION_IDLE_MINUTES=30
#ROADVISION_WEB_LOGIN_RATE_PER_MINUTE=5

# Linux/V4L2 kamera piksel formatı isteği (varsayılan MJPG; boş = kapalı).
# UVC webcam'lerde 1280x720@30 için MJPG gerekir; sorunlu sürücüde YUYV denenebilir.
#ROADVISION_CAMERA_FOURCC=MJPG

# Jetson CSI sensörlerini kamera listesine ekler (ör. 0 veya 0,1).
# Sistem OpenCV'sinin GStreamer desteği ve nvarguscamerasrc gereklidir.
#ROADVISION_CSI_SENSORS=0
#ROADVISION_CSI_FLIP_METHOD=0

# Tespit görüntüsü kaydı (db/off)
ROADVISION_MEDIA=db
ROADVISION_MEDIA_JPEG_QUALITY=80
ROADVISION_MEDIA_MAX_EDGE=1280
ROADVISION_MEDIA_MIN_INTERVAL_S=2.0
ROADVISION_MEDIA_MAX_PER_RUN=200
ROADVISION_MEDIA_MAX_PER_HOUR=500
ROADVISION_MEDIA_QUEUE_SIZE=8
ROADVISION_MEDIA_QUEUE_MAX_MB=256
ROADVISION_MEDIA_RETENTION_DAYS=30
# Kota/retention temizliği en fazla bu aralıkta bir çalışır (0 = her yazımda)
ROADVISION_MEDIA_PRUNE_INTERVAL_S=60
ROADVISION_MEDIA_MAX_TOTAL_MB=2048
ROADVISION_MEDIA_SHUTDOWN_TIMEOUT_S=10
